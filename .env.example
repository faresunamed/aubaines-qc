# --- Base de données : DEUX modes (voir README) ---
# Mode API Supabase (aucune adresse Postgres) : utilisé dès que ces deux variables existent.
# SUPABASE_SECRET_KEY est SECRÈTE : jamais dans le navigateur, le dépôt ou une conversation.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Force un mode : api | pg (sinon automatique)
DB_MODE=
# Mode direct Postgres (développement local, Neon, Supabase pooler…) :
# Si absente, l'application lit POSTGRES_URL (créée par l'intégration Vercel ↔ Supabase).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/aubaines
# Optionnel : certificat CA du serveur (PEM) pour VÉRIFIER la connexion SSL.
# Sans lui, la connexion est chiffrée mais le certificat n'est pas vérifié.
DATABASE_CA=
# Optionnel : connexions max par instance (défaut 3 en production, 10 en local).
DATABASE_POOL_MAX=

# --- Sécurité : générer avec  openssl rand -base64 32 ---
AUTH_SECRET=changez-moi-avec-une-longue-valeur-aleatoire

# --- URL publique du site (utilisée dans les courriels, le sitemap et les liens) ---
APP_URL=http://localhost:3000

# --- Courriel (Resend). Sans RESEND_API_KEY, les courriels sont écrits dans la table email_outbox (dev) ---
RESEND_API_KEY=
MAIL_FROM="Aubaines QC <alertes@votredomaine.ca>"

# --- Administration ---
# Reçoit un courriel à chaque nouvelle demande commerçant (optionnel)
ADMIN_EMAIL=
# Protège /api/cron/alerts (Authorization: Bearer <CRON_SECRET>). Vide = route fermée.
CRON_SECRET=
